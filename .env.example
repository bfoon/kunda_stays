# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
SEED_DEMO=1

# --- Database / cache ---
POSTGRES_DB=kunda
POSTGRES_USER=kunda
POSTGRES_PASSWORD=kunda
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# --- Business details (shown across the site, receipts and messages) ---
BUSINESS_NAME=Kunda Stays
BUSINESS_TAGLINE=Serviced apartments by the Atlantic
BUSINESS_PHONE=+220 300 0000
BUSINESS_WHATSAPP=2203000000
BUSINESS_EMAIL=stay@kunda.gm
BUSINESS_ADDRESS=Kairaba Avenue, Serrekunda, The Gambia
BUSINESS_LAT=13.4549
BUSINESS_LNG=-16.6790
DEFAULT_COUNTRY_CODE=220
CURRENCY_CODE=GMD
CURRENCY_SYMBOL=D
BOOKING_HOLD_HOURS=24
CHECKIN_TIME=14:00
CHECKOUT_TIME=11:00

# --- Payment instructions shown to guests ---
WAVE_NUMBER=+220 300 0000
AFRIMONEY_NUMBER=+220 700 0000
QMONEY_NUMBER=+220 600 0000
BANK_DETAILS=Trust Bank Gambia · Kunda Stays Ltd · Acc 0000000000

# --- WhatsApp Cloud API (optional; leave blank to use click-to-send links) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- First admin user created by seed_demo ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
